{
  "manifest_version": 3,
  "name": "ZERACK",
  "version": "4.92.1",
  "description": "Real YouTube intelligence: views per hour, viral multiplier, tier, revenue estimate and faceless detection on every card.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite",
    "tabs",
    "alarms",
    "notifications",
    "cookies",
    "downloads",
    "offscreen",
    "sidePanel",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.fish.audio/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://i.ytimg.com/*",
    "https://img.youtube.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://127.0.0.1:7788/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/nsp-data-tools.js",
        "content/ashlyv-bridge.js",
        "lib/face-api/face-api.min.js",
        "content/nsp-faces.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/nsp-models.js",
        "ashlyv/ashlyv-engine.js",
        "knowledge/youtube-playbook.js",
        "knowledge/reverse-engine.js",
        "knowledge/course.js",
        "lib/nsp-brain.js",
        "content/nsp-bundle.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "lib/nsp-text.js",
        "content/nsp-studio.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "js": [
        "content/zerack-bubble.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ZERACK"
  },
  "side_panel": {
    "default_path": "chat/chat.html?mode=panel"
  },
  "commands": {
    "talk": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Talk to ZERACK: press to speak, press again to send"
    },
    "chat": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Open or close the ZERACK chat"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/face-api/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "use_dynamic_url": true
    },
    {
      "resources": [
        "chat/chat.html",
        "icons/zerack-bubble.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
