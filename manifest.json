{
  "manifest_version": 3,
  "name": "NicheScanner Pro",
  "version": "4.92.1",
  "description": "Overlay métricas reales sobre YouTube: VPH, multiplier viral, tiers, revenue estimate.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite",
    "tabs",
    "alarms",
    "notifications",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://i.ytimg.com/*",
    "https://img.youtube.com/*",
    "https://image.pollinations.ai/*",
    "https://*.pollinations.ai/*",
    "https://api.openverse.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/face-api/face-api.min.js",
        "ashlyv/ashlyv-engine.js",
        "knowledge/youtube-playbook.js",
        "knowledge/reverse-engine.js",
        "content/nsp-bundle.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/ashlyv-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "lib/nsp-text.js",
        "content/nsp-studio.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NicheScanner Pro"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/*",
        "ashlyv/ashlyv.html",
        "ashlyv/*",
        "ashlyv/tools/*",
        "country-feed/country-feed.html",
        "country-feed/*",
        "niche-index/niche-index.html",
        "niche-index/*",
        "monetize-studio/index.html",
        "monetize-studio/*",
        "lib/face-api/*",
        "lib/mobilenet/*",
        "lib/whisper/*",
        "lib/whisper/models/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}