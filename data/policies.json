    "de_history_main": {
      "lang": "de",
      "niche": "historia",
      "notes": "German-language history channel. StGB §86 and §86a cover spreading propaganda and using the symbols of unconstitutional organizations. A hit here means remove or rewrite the passage: neutral historical narration is fine, a literal name, symbol or glorification is not. Every rule states its match mode: acronyms and terms of 4 characters or fewer use 'word', because after folding ß to ss the string 'ss' sits inside strasse, wasser and besser and substring would fire on every script.",
      "hardBlock": [
        {
          "id": "de86-001",
          "scope": "channel.de_history_main.stgb86",
          "match": "word",
          "severity": "hard",
          "term": "ss",
          "note": "Acronym of a banned organization. Word match is required, because after folding ß to ss the term sits inside strasse, wasser and besser, plus the uppercase guard: it only counts when the original is fully uppercase ('SS' yes, a bare 'ss' no). Accepted trade-off: a lowercase 'ss' in informal prose is not detected, and that false negative buys the removal of a flood of false positives. Our pipeline writes German with standard capitalization, so the real exposure is nil. Do not 'fix' the guard without re-evaluating that consequence."
        },
        {
          "id": "de86-002",
          "scope": "channel.de_history_main.stgb86",
          "match": "word",
          "severity": "hard",
          "term": "sa",
          "note": "Acronym of a banned organization. Word match required (4 characters or fewer) plus the uppercase guard: 'SA marschierte' matches, 'Sa. geschlossen' (Saturday) does not."
        },
        {
          "id": "de86-003",
          "scope": "channel.de_history_main.stgb86",
          "match": "word",
          "severity": "hard",
          "term": "hj",
          "note": "Acronym of a banned youth organization. Word match required (4 characters or fewer) plus the uppercase guard."
